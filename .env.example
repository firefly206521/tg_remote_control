# Telegram Bot（必填）
# 在 @BotFather 创建 Bot 后填写。切勿把真实 token 提交到版本库。
BOT_TOKEN=YOUR_BOT_ID:YOUR_BOT_TOKEN

# 可选：填写后启用独立的 Claude Bot；留空则使用单 Bot 兼容模式。
CLAUDE_BOT_TOKEN=

# 允许使用 Bot 的 Telegram 数字用户 ID，多个 ID 用英文逗号分隔。
# 首次可暂时留空进入配对模式：Bot 只返回来访者 ID，不执行任务。
ALLOWED_USER_IDS=

# 可选代理，例如 http://127.0.0.1:7890；直连时留空。
PROXY_URL=

# AI CLI 默认工作目录。留空时使用项目内的 workspace 目录。
DEFAULT_WORKDIR=

# Codex CLI
CODEX_SANDBOX=workspace-write
CODEX_NETWORK=true
CODEX_MODEL=
CODEX_MODELS=gpt-5.1-codex-max,gpt-5.1-codex,gpt-5.1-codex-mini
CODEX_EFFORT_LEVELS=minimal,low,medium,high

# Claude Code CLI
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_MODEL=
CLAUDE_MODELS=opus,sonnet,haiku
CLAUDE_EFFORT_LEVELS=low,medium,high,xhigh,max
CLAUDE_AUTO_COMPACT_SECONDS=0
CLAUDE_AUTO_COMPACT_RETRIES=1

# 调度与消息
QUEUE_LIMIT=3
MAX_SESSIONS=8
FILE_THRESHOLD=3500
STATUS_EDIT_INTERVAL=4

# 本机 Web GUI。服务始终绑定 127.0.0.1。
GUI_PORT=8765
GUI_PORT_CLAUDE=8766
# 留空则首次启动时自动生成并保存到 .gui-token。
GUI_TOKEN=
